{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)\\.(js|css|html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/news.html",
      "destination": "/activities.html#announcements",
      "permanent": true
    },
    {
      "source": "/news",
      "destination": "/activities.html#announcements",
      "permanent": true
    }
  ]
}
